        "language": "javaScript",
        "jsCode": "const expression = String(query.expression || '');\nif (!/^[0-9+\\-*/%().\\s]+$/.test(expression)) {\n  return 'Error: only numbers and + - * / % ( ) are allowed';\n}\nreturn String(Function('\"use strict\"; return (' + expression + ')')());",
